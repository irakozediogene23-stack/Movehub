function handleLogin(e){
  e.preventDefault();const errEl=document.getElementById('loginError');errEl.classList.add('hidden');
  const email=document.getElementById('loginEmail').value.trim(),pw=document.getElementById('loginPassword').value;
  const account=getAccounts().find(a=>a.email===email&&a.password===pw);
  if(!account){errEl.textContent='Invalid email or password. Please try again.';errEl.classList.remove('hidden');return;}
  setSavedUser(account);closeModal('loginModal');showToast(`Welcome back, ${account.fullName}!`,'success');
  setTimeout(()=>enterDashboard(),400);
}

