    const tripCode = routeAssignment && routeAssignment.tripCode ? routeAssignment.tripCode : getTripCodeForRoute(selectedBus.routeLabel);
    const tripAmount = routeAssignment && routeAssignment.fare ? routeAssignment.fare : selectedBus.price;
    const ticketCode = generateTicketNumber(selectedBus.routeLabel, tripAmount);
    const bookingRecord = {
      id: Date.now().toString(36), userEmail: currentUser ? currentUser.email : 'guest@example.com', userName: currentUser ? currentUser.fullName : 'Guest Passenger', route: `${selectedBus.from} → ${selectedBus.to}`, company: selectedBus.company, departure: selectedBus.departure, date: new Date().toISOString(), amount: tripAmount, tripCode, seat: selectedSeat, ticketNumber: ticketCode, status: 'paid', source: 'USSD', createdAt: new Date().toISOString()
