function renderDashboardPage(user, page) { const role = ROLES.find(r => r.id === user.role); if (!role) return; const title = document.getElementById('dashboardTitle'); const subtitle = document.getElementById('dashboardSubtitle'); const content = document.getElementById('dashboardContent'); if (!title || !subtitle || !content) return; if (role.id === 'passenger') renderPassenger(page, user, content, title, subtitle); else if (role.id === 'agent') renderAgent(page, user, content, title, subtitle); else if (role.id === 'admin') renderAdmin(page, user, content, title, subtitle); else if (role.id === 'driver') renderDriver(page, user, content, title, subtitle); }

function generateRouteCards(busListContainer) {
  return BUS_DATA.map((b, i) => {
    const highestSlot = (b.schedule || []).slice().sort((a, c) => a.available - c.available)[0] || { available: 0, status: 'available' };
    const tripStatus = highestSlot.status === 'gone' ? 'Gone' : highestSlot.available <= 5 ? 'Limited' : 'Available';
    return `<div class="flex items-center justify-between p-4 bg-white rounded-2xl border border-[var(--border)] hover:border-[var(--primary)] transition cursor-pointer" onclick="selectBus(${i})"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-xl flex items-center justify-center font-bold text-xl text-white" style="background:${b.color}">${b.letter}</div><div><div class="font-display font-bold">${b.company}</div><div class="text-sm text-[var(--muted)]">${b.from} → ${b.to} · ${b.duration}</div><div class="text-xs text-[var(--muted)] mt-1">${(b.schedule || []).map(s => `${s.time} (${s.status === 'gone' ? 'Gone' : `${s.available} left`})`).join(' · ')}</div></div></div><div class="text-right"><div class="font-display font-bold text-lg text-[var(--primary)]">${b.price.toLocaleString()} RWF</div><div class="text-xs ${tripStatus === 'Gone' ? 'text-[var(--danger)]' : 'text-[var(--muted)]'}">${tripStatus}</div></div></div>`;
  }).join('');
}

