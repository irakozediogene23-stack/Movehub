<!-- Mobile menu -->
<div id="mobileMenu" class="fixed inset-0 bg-[var(--bg)] z-50 p-7 lg:hidden transform translate-x-full transition-transform duration-300">
  <div class="flex justify-between items-center mb-12">
    <div class="flex items-center gap-2.5"><img src="https://z-cdn-media.chatglm.cn/files/09ac5cf7-b42c-47f9-9063-957cc3c348b9.png?auth_key=1884368624-da42c1fab4224c319d4423887ee93b58-0-9cc1dec7401b29d266d90867369ef69a" alt="MoveHub" class="logo-img"><span class="font-display text-2xl font-bold tracking-tight text-[var(--primary)]">MoveHub</span></div>
