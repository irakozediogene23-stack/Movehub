function closeModal(id) { const m = document.getElementById(id); if (!m) return; m.classList.add('opacity-0'); const p = m.querySelector('.modal-panel'); if (p) p.classList.add('scale-95', 'opacity-0'); setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); document.body.style.overflow = ''; }, 300); }
