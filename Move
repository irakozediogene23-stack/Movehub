    <button onclick="document.getElementById('mobileMenu').classList.add('translate-x-full');openModal('loginModal')" class="w-full border-2 border-[var(--fg-soft)] text-[var(--fg-soft)] rounded-full py-3 font-semibold">Sign in</button>
    <button onclick="document.getElementById('mobileMenu').classList.add('translate-x-full');openCreateAccountFlow()" class="w-full btn-accent rounded-full py-3 font-semibold">Create Account</button>
  </div>
</div>

