    const tripCode = routeAssignment && routeAssignment.tripCode ? routeAssignment.tripCode : getTripCodeForRoute(selectedBus.routeLabel);
    const tripAmount = routeAssignment && routeAssignment.fare ? routeAssignment.fare : selectedBus.price;
