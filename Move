    else h+=`<input type="${f.type}" name="${f.name}" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--border)] focus:outline-none focus:border-[var(--primary)] reg-input" placeholder="${f.placeholder}" ${f.required?'required':''} id="reg_f_${f.name}">`;
