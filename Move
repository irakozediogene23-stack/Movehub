function selectBus(i) {
  selectedBus = BUS_DATA[i]; selectedSeat = null;
  const routeAssignment = getFleetAssignments().find(item => item.route.toLowerCase() === selectedBus.routeLabel.toLowerCase());
  const statusText = routeAssignment && routeAssignment.started ? 'Journey has started' : 'Ready for boarding';
  const title = document.getElementById('selectedBusTitle'); const info = document.getElementById('selectedBusInfo'); const price = document.getElementById('selectedBusPrice');
  if (title) title.textContent = `Select Your Seat — ${selectedBus.company}`;
  if (info) info.textContent = `${selectedBus.from} → ${selectedBus.to} · ${selectedBus.departure} · ${statusText}`;
  if (price) price.textContent = `${selectedBus.price.toLocaleString()} RWF`;
  const seatLabel = document.getElementById('selectedSeatLabel'); if (seatLabel) seatLabel.textContent = 'None';
  const proceed = document.getElementById('proceedToPayment'); if (proceed) proceed.disabled = true;
  const c = document.getElementById('seatMapContainer'); if (!c) return;
  const total = selectedBus.seats; const taken = new Set(); while (taken.size < 18) taken.add(Math.floor(Math.random() * total) + 1);
  let html = '<div class="seat driver"><i class="fa-solid fa-circle text-xs"></i></div>';
  for (let s = 1; s <= Math.min(total, 50); s++) {
    const row = Math.ceil(s / 4), col = ((s - 1) % 4), label = `${row}${String.fromCharCode(65 + col)}`;
    if (col === 2 && s > 1) html += '<div class="w-4"></div>';
    html += taken.has(s) ? `<div class="seat taken">${label}</div>` : `<div class="seat available" onclick="pickSeat(this,'${label}')">${label}</div>`;
  }
  c.innerHTML = html;
  switchFormStep('bookingModal', 'bookingStep1', 'bookingStep2');
