    alerts.push({ id: Date.now().toString(36), driverName, message: `You have been assigned to ${route} with plate ${plateNumber}. Use code ${tripCode}. Please press Start Journey when ready.` });
    saveDriverAlerts(alerts);
    showToast(`${plateNumber} assigned to ${driverName}.`, 'success');
    form.reset();
