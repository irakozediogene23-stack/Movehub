function initRoleCards() { const c = document.getElementById('roleCardsContainer'); if (!c) return; c.innerHTML = ROLES.map(r => `<div class="role-card cursor-pointer p-5 rounded-2xl border-2 border-[var(--border)] bg-white flex items-center gap-4" data-role="${r.id}"><div class="role-icon w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0" style="background:${r.color}15;color:${r.color}"><i class="${r.icon} text-xl"></i></div><div class="flex-1 min-w-0"><div class="font-display font-bold text-base">${r.label}</div><div class="text-sm text-[var(--muted)] leading-tight">${r.desc}</div></div><div class="w-6 h-6 rounded-full border-2 border-[var(--border)] flex-shrink-0 role-check flex items-center justify-center"></div></div>`).join(''); c.querySelectorAll('.role-card').forEach(card => { card.addEventListener('click', () => { c.querySelectorAll('.role-card').forEach(x => { x.classList.remove('selected'); const ch = x.querySelector('.role-check'); if (ch) { ch.innerHTML = ''; ch.style.borderColor = ''; } }); card.classList.add('selected'); const chk = card.querySelector('.role-check'); if (chk) { chk.innerHTML = '<i class="fa-solid fa-check text-[var(--primary)] text-xs"></i>'; chk.style.borderColor = 'var(--primary)'; } selectedRole = card.dataset.role; const proceed = document.getElementById('proceedToRegistration'); if (proceed) proceed.disabled = false; }); }); }

function showRegistrationForm() { const role = ROLES.find(r => r.id === selectedRole); if (!role) return; const regIcon = document.getElementById('regRoleIcon'); if (regIcon) { regIcon.innerHTML = `<i class="${role.icon} text-xl text-white"></i>`; regIcon.style.background = role.color; } const regTitle = document.getElementById('regRoleTitle'); const regSubtitle = document.getElementById('regRoleSubtitle'); if (regTitle) regTitle.textContent = `Register as ${role.label}`; if (regSubtitle) regSubtitle.textContent = role.desc; const fields = ROLE_FIELDS[selectedRole]; const container = document.getElementById('regFieldsContainer'); if (!container) return; const rows = []; for (let i = 0; i < fields.length; i++) { const f = fields[i]; const isPwd = f.type === 'password'; let html = `<div><label class="block text-xs font-bold text-[var(--muted)] uppercase tracking-wider mb-2">${f.label}${f.required ? ' *' : ''}</label>`; if (isPwd) { html += `<div class="password-wrapper"><input type="password" name="${f.name}" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--border)] focus:outline-none focus:border-[var(--primary)] pr-12 reg-input" placeholder="${f.placeholder}" ${f.required ? 'required' : ''} minlength="8" id="reg_f_${f.name}"><span class="password-toggle" onclick="togglePwd('reg_f_${f.name}',this)"><i class="fa-solid fa-eye"></i></span></div>`; } else { html += `<input type="${f.type}" name="${f.name}" class="w-full px-4 py-3 rounded-xl bg-white border border-[var(--border)] focus:outline-none focus:border-[var(--primary)] reg-input" placeholder="${f.placeholder}" ${f.required ? 'required' : ''} id="reg_f_${f.name}">`; } html += '</div>'; rows.push(html); } container.innerHTML = `<div class="grid grid-cols-1 md:grid-cols-2 gap-4">${rows.join('')}</div>`; switchFormStep('createAccountModal', 'createStep1', 'createStep2'); }

function handleRegistration(e) { e.preventDefault(); const errEl = document.getElementById('regError'); if (errEl) errEl.classList.add('hidden'); const data = {}; e.target.querySelectorAll('.reg-input').forEach(inp => { data[inp.name] = inp.value.trim(); }); if (!data.email || !data.email.includes('@')) { if (errEl) { errEl.textContent = 'Please enter a valid email address.'; errEl.classList.remove('hidden'); } return; } if (data.password.length < 8) { if (errEl) { errEl.textContent = 'Password must be at least 8 characters.'; errEl.classList.remove('hidden'); } return; } if (data.password !== data.confirmPassword) { if (errEl) { errEl.textContent = 'Passwords do not match.'; errEl.classList.remove('hidden'); } return; } const accounts = getAccounts(); if (accounts.find(a => a.email === data.email)) { if (errEl) { errEl.textContent = 'An account with this email already exists.'; errEl.classList.remove('hidden'); } return; } const newAcct = { ...data, role: selectedRole, id: Date.now().toString(36), createdAt: new Date().toISOString() }; delete newAcct.confirmPassword; accounts.push(newAcct); saveAccounts(accounts); const role = ROLES.find(r => r.id === selectedRole); const regInfo = document.getElementById('regSuccessInfo'); if (regInfo) regInfo.textContent = `You've been registered as a ${role.label}. You can now sign in with your email and password.`; switchFormStep('createAccountModal', 'createStep2', 'createStep3'); showToast(`Account created as ${role.label}!`, 'success'); }

function handleLogin(e) { e.preventDefault(); const errEl = document.getElementById('loginError'); if (errEl) errEl.classList.add('hidden'); const email = document.getElementById('loginEmail').value.trim(); const pw = document.getElementById('loginPassword').value; const account = getAccounts().find(a => a.email === email && a.password === pw); if (!account) { if (errEl) { errEl.textContent = 'Invalid email or password. Please try again.'; errEl.classList.remove('hidden'); } return; } setSavedUser(account); closeModal('loginModal'); showToast(`Welcome back, ${account.fullName}!`, 'success'); setTimeout(() => enterDashboard(), 400); }

