function generateTicketNumber(routeLabel, amount) { const routeCode = (routeLabel || '').replace(/[^A-Za-z]/g, '').slice(0, 3).toUpperCase() || 'TRP'; const ran = Math.random().toString(36).slice(2, 7).toUpperCase(); const amt = String(amount || 0).padStart(4, '0'); return `MH-${routeCode}-${amt}-${ran}`; }
function getTripCodeForRoute(routeLabel) { const assignments = getFleetAssignments(); const match = assignments.find(item => (item.route || '').toLowerCase() === (routeLabel || '').toLowerCase()); return (match && match.tripCode) ? match.tripCode : (routeLabel || '').replace(/[^A-Za-z]/g, '').slice(0, 4).toUpperCase() || 'MHK'; }

function startAssignedJourney(id) {
  const fleet = getFleetAssignments();
  const selected = fleet.find(bus => bus.id === id);
  if (!selected) { showToast('No assigned trip found.', 'error'); return; }
  const updated = fleet.map(bus => bus.id === id ? { ...bus, started: true, tripStatus: 'started' } : bus);
  saveFleetAssignments(updated);
  // remove alert once started
  const alerts = getDriverAlerts().filter(item => !(item.driverName === selected.driverName && item.message.includes(selected.route)));
  saveDriverAlerts(alerts);
  showToast(`Journey started for ${selected.route}. Passengers will now see it as active.`, 'success');
  if (currentUser && currentUser.role === 'driver') { renderDashboardPage(currentUser, 'overview'); }
}

