function handleRegistration(e){
  e.preventDefault();const errEl=document.getElementById('regError');errEl.classList.add('hidden');
  const data={};e.target.querySelectorAll('.reg-input').forEach(inp=>{data[inp.name]=inp.value.trim();});
  if(!data.email||!data.email.includes('@')){errEl.textContent='Please enter a valid email address.';errEl.classList.remove('hidden');return;}
  if(data.password.length<8){errEl.textContent='Password must be at least 8 characters.';errEl.classList.remove('hidden');return;}
  if(data.password!==data.confirmPassword){errEl.textContent='Passwords do not match.';errEl.classList.remove('hidden');return;}
  const accounts=getAccounts();
  if(accounts.find(a=>a.email===data.email)){errEl.textContent='An account with this email already exists.';errEl.classList.remove('hidden');return;}
  const newAcct={...data,role:selectedRole,id:Date.now().toString(36),createdAt:new Date().toISOString()};
  delete newAcct.confirmPassword;accounts.push(newAcct);saveAccounts(accounts);
  const role=ROLES.find(r=>r.id===selectedRole);
  document.getElementById('regSuccessInfo').textContent=`You've been registered as a ${role.label}. You can now sign in with your email and password.`;
  switchFormStep('createAccountModal','createStep2','createStep3');showToast(`Account created as ${role.label}!`,'success');
}

