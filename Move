  L.polyline(rc,{color:'#1F4D3C',weight:4,dashArray:'10 6'}).addTo(map);
  const bm=L.marker([-1.75,29.70],{icon:L.divIcon({className:'',html:'<div class="bus-icon"><i class="fa-solid fa-bus"></i></div>',iconSize:[36,36],iconAnchor:[18,18]})}).addTo(map);
  bm.bindPopup('<b>Trinity Express</b><br>Kigali → Musanze<br>65 / 110 km covered');
  L.marker([-1.95,30.06],{icon:L.divIcon({className:'',html:'<div style="background:#1F4D3C;width:14px;height:14px;border-radius:50%;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,.3)"></div>',iconSize:[14,14],iconAnchor:[7,7]})}).addTo(map).bindPopup('<b>Nyabugogo Park</b>');
  L.marker([-1.50,29.45],{icon:L.divIcon({className:'',html:'<div style="background:#E8804B;width:14px;height:14px;border-radius:50%;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,.3)"></div>',iconSize:[14,14],iconAnchor:[7,7]})}).addTo(map).bindPopup('<b>Musanze Park</b>');
  let step=0;
  setInterval(()=>{step=(step+1)%rc.length;bm.setLatLng(rc[step]);},3000);
}

/* ========== TABS ========== */
function initTabs(){document.querySelectorAll('.tab-btn').forEach(btn=>{btn.addEventListener('click',()=>{document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.tab-content').forEach(c=>{c.classList.remove('active');c.classList.add('hidden');});btn.classList.add('active');const t=document.getElementById(`tab-${btn.dataset.tab}`);if(t){t.classList.add('active');t.classList.remove('hidden');}});});}

/* ========== INIT ========== */
  document.getElementById('fleetForm')?.addEventListener('submit',function(e){
    e.preventDefault();
    const form=e.target;const plateNumber=form.plateNumber.value.trim();const driverName=form.driverName.value.trim();const route=form.route.value.trim();const departure=form.departure.value;
    if(!plateNumber||!driverName||!route||!departure){showToast('Please complete the bus assignment form.','error');return;}
    const fleet=getFleetAssignments();
    fleet.push({id:Date.now().toString(36),plateNumber,driverName,route,departure,company:'Company Bus',started:false,createdAt:new Date().toISOString()});
    saveFleetAssignments(fleet);
    const alerts=getDriverAlerts();
    alerts.push({id:Date.now().toString(36),driverName,message:`You have been assigned to ${route} with plate ${plateNumber}. Please press Start Journey when ready.`});
    saveDriverAlerts(alerts);
    showToast(`${plateNumber} assigned to ${driverName}.`, 'success');
    form.reset();
    if(currentUser && currentUser.role === 'admin'){renderDashboardPage(currentUser,'fleet');}
  });document.addEventListener('DOMContentLoaded',()=>{
  initCarousel();initTabs();initRoleCards();

  document.getElementById('menuBtn').addEventListener('click',()=>document.getElementById('mobileMenu').classList.remove('translate-x-full'));
  document.getElementById('closeMenu').addEventListener('click',()=>document.getElementById('mobileMenu').classList.add('translate-x-full'));

  document.getElementById('proceedToRegistration').addEventListener('click',()=>{if(selectedRole)showRegistrationForm();});
  document.getElementById('registrationForm').addEventListener('submit',handleRegistration);
  document.getElementById('loginForm').addEventListener('submit',handleLogin);
  document.getElementById('fleetForm')?.addEventListener('submit',function(e){
    e.preventDefault();
    const form=e.target;const plateNumber=form.plateNumber.value.trim();const driverName=form.driverName.value.trim();const route=form.route.value.trim();const departure=form.departure.value;const tripCode=form.tripCode.value.trim();const fare=Number(form.fare.value);
    if(!plateNumber||!driverName||!route||!departure||!tripCode||!fare){showToast('Please complete the full bus assignment form.','error');return;}
    const fleet=getFleetAssignments();
    fleet.push({id:Date.now().toString(36),plateNumber,driverName,route,departure,tripCode, fare,company:'Company Bus',started:false,createdAt:new Date().toISOString()});
    saveFleetAssignments(fleet);
    const alerts=getDriverAlerts();
    alerts.push({id:Date.now().toString(36),driverName,message:`You have been assigned to ${route} with plate ${plateNumber}. Use code ${tripCode}. Please press Start Journey when ready.`});
    saveDriverAlerts(alerts);
    showToast(`${plateNumber} assigned to ${driverName}.`, 'success');
    form.reset();
    if(currentUser && currentUser.role === 'admin'){renderDashboardPage(currentUser,'fleet');}
  });
  document.getElementById('proceedToPayment').addEventListener('click',()=>{
    const routeAssignment = getFleetAssignments().find(item => item.route.toLowerCase() === selectedBus.routeLabel.toLowerCase());
    const tripCode = routeAssignment && routeAssignment.tripCode ? routeAssignment.tripCode : getTripCodeForRoute(selectedBus.routeLabel);
    const tripAmount = routeAssignment && routeAssignment.fare ? routeAssignment.fare : selectedBus.price;
    const ussdCode = `*182*8*1*${tripCode}#`;
    document.getElementById('payBusCompany').textContent=selectedBus.company;
    document.getElementById('payBusSeat').textContent=selectedSeat;
    document.getElementById('payBusPrice').textContent=`${tripAmount.toLocaleString()} RWF`;
    document.getElementById('ussdCode').textContent=ussdCode;
    document.getElementById('paymentPhone').value = currentUser ? currentUser.phone || '' : '';
    switchFormStep('bookingModal','bookingStep2','bookingStep3');
  });
  document.getElementById('confirmPaymentBtn').addEventListener('click',()=>{
    const routeAssignment = getFleetAssignments().find(item => item.route.toLowerCase() === selectedBus.routeLabel.toLowerCase());
    const tripCode = routeAssignment && routeAssignment.tripCode ? routeAssignment.tripCode : getTripCodeForRoute(selectedBus.routeLabel);
    const tripAmount = routeAssignment && routeAssignment.fare ? routeAssignment.fare : selectedBus.price;
    const ticketCode = generateTicketNumber(selectedBus.routeLabel, tripAmount);
    const bookingRecord = {
      id: Date.now().toString(36),
      userEmail: currentUser ? currentUser.email : 'guest@example.com',
      userName: currentUser ? currentUser.fullName : 'Guest Passenger',
      route: `${selectedBus.from} → ${selectedBus.to}`,
      company: selectedBus.company,
      departure: selectedBus.departure,
      date: new Date().toISOString(),
      amount: tripAmount,
      tripCode,
      seat: selectedSeat,
      ticketNumber: ticketCode,
      status: 'paid',
      source: 'USSD',
      createdAt: new Date().toISOString()
    };
    const bookings = getPassengerBookings();
    bookings.unshift(bookingRecord);
    savePassengerBookings(bookings);
    document.getElementById('ticketDetails').innerHTML=`<div class="flex justify-between"><span>Route:</span><span class="font-bold">${selectedBus.from} → ${selectedBus.to}</span></div><div class="flex justify-between"><span>Company:</span><span class="font-bold">${selectedBus.company}</span></div><div class="flex justify-between"><span>Seat:</span><span class="font-bold">${selectedSeat}</span></div><div class="flex justify-between"><span>Departure:</span><span class="font-bold">${selectedBus.departure}</span></div><div class="flex justify-between"><span>Ticket:</span><span class="font-bold">${ticketCode}</span></div><div class="flex justify-between"><span>Trip Code:</span><span class="font-bold">${tripCode}</span></div>`;
    document.getElementById('ticketCode').textContent=ticketCode;
    switchFormStep('bookingModal','bookingStep3','bookingStep4');
    if(currentUser && currentUser.role === 'passenger'){renderDashboardPage(currentUser,'bookings');}
    showToast('Payment confirmed. Ticket generated successfully!','success');
  });

  /* Initialize map when tracking section becomes visible */
  const mapEl=document.getElementById('mapContainer');
  if(mapEl){
    const obs=new IntersectionObserver(entries=>{
      if(entries[0].isIntersecting){initMap();obs.disconnect();}
    },{threshold:0.05});
    obs.observe(mapEl);
  }

  /* Auto-login */
  const saved=getSavedUser();
  if(saved){currentUser=saved;enterDashboard();}
});
</script>
